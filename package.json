{
  "name": "event-concierge-backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "postinstall": "prisma generate",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test,prisma}/**/*.{ts,js}\"",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write \"{src,test,prisma}/**/*.{ts,js,json}\" \"*.{md,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.spec.ts' --exclude '**/*.e2e-spec.ts'",
    "test:integration": "vitest run --passWithNoTests test/integration",
    "test:e2e": "vitest run test/app.e2e-spec.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:admin": "SEED_SCOPE=admin tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.6",
    "@prisma/client": "^6.16.2",
    "@supabase/supabase-js": "^2.57.2",
    "@vercel/functions": "^3.9.5",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "mammoth": "^1.10.0",
    "nestjs-pino": "^4.4.1",
    "nodemailer": "^9.1.1",
    "openai": "^7.9.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.0.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "unpdf": "^1.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.16.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^3.2.4"
  }
}
